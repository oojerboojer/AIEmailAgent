        "messages": {
          "values": [
            {
              "content": "=You are an executive assistant triage bot. Analyze incoming emails.\nReturn valid JSON with:\n1. summary: A 2-sentence summary of the message. The message is from{{ $json.text }}\n2. urgency: \"High\", \"Medium\", or \"Low\".\n3. core_request: The specific ask or deadline.\n4. draft_reply: A professional, concise contextual response addressing all asks."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        480,
        0
      ],
      "id": "e79db7c8-a18e-4f3d-a975-ac90e0925f7f",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "FREE Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // 1. Target the exact path where the LLM placed the text\n  let rawText = item.json.content.parts[0].text;\n  \n  // 2. Strip out the markdown formatting (```json and ```)\n  let cleanText = rawText.replace(/```json/gi, '').replace(/```/gi, '').trim();\n  \n  // 3. Convert the clean string into a real JSON object\n  let parsedData = JSON.parse(cleanText);\n  \n  // 4. Attach the separated fields directly to the main output\n  Object.assign(item.json, parsedData);\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "id": "0ab20cb0-52f2-4c50-a447-d88c29533c66",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c40fb219-1c94-4f83-a646-eeb8d12b5335",
              "leftValue": "={{ ($json.urgency || '').toLowerCase() }}",
              "rightValue": "low",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
